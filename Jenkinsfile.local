pipeline {
    agent any

    environment {
        IMAGE_NAME = "secure-task-api"
        CONTAINER_NAME = "secure-task-api-local"
        APP_PORT = "5000"
        HOST_PORT = "5000"
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Python Environment') {
            steps {
                bat '''
                python -m venv venv
                call venv\\Scripts\\activate
                python -m pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('Lint - Flake8') {
            steps {
                bat '''
                call venv\\Scripts\\activate
                flake8 app.py test_app.py
                '''
            }
        }

        stage('Tests - Pytest') {
            steps {
                bat '''
                call venv\\Scripts\\activate
                pytest -v
                '''
            }
        }

        stage('Security - Bandit') {
            steps {
                bat '''
                call venv\\Scripts\\activate
                bandit -r app.py
                '''
            }
        }

        stage('Security - pip-audit') {
            steps {
                bat '''
                call venv\\Scripts\\activate
                pip-audit
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                docker build -t %IMAGE_NAME%:local .
                '''
            }
        }

        stage('Scan Docker Image - Trivy') {
            steps {
                bat '''
                trivy image --severity HIGH,CRITICAL %IMAGE_NAME%:local
                '''
            }
        }

        stage('Deploy Local Container') {
            steps {
                bat '''
                docker rm -f %CONTAINER_NAME% || exit /b 0
                docker run -d --name %CONTAINER_NAME% -p %HOST_PORT%:%APP_PORT% %IMAGE_NAME%:local
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline terminé avec succès.'
            echo "Application déployée localement sur le port ${HOST_PORT}."
        }
        failure {
            echo "Le pipeline a échoué. Vérifie les logs Jenkins."
        }
        always {
            cleanWs()
        }
    }
}